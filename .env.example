# Секрет для подписи сессионных cookie. Обязателен в production (от 16 символов).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PTO_SESSION_SECRET=

# Токен для сервисного ингеста готовых листов из внешнего пайплайна.
# Без него /api/documents/<id>/pages/<n> отвечает 503.
PTO_INGEST_TOKEN=

# 1 = cookie только по HTTPS (включите после SSL). Пока сайт на http://IP — не ставьте.
# PTO_COOKIE_SECURE=1

# Необязательно: куда складывать data/ и uploads/. По умолчанию — корень проекта.
# DATA_ROOT=
