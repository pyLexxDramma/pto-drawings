// --------------------------------------------------------------------- сборка

const existing = (await storage.listProjects()).find(
  (item) => item.name === PROJECT_NAME,
);
if (existing) {
  await storage.deleteProject(existing.id);
  console.log("прежняя фикстура удалена");
}

const project = await storage.createProject(
  PROJECT_NAME,
  "Фикстура для проверки читаемости расшифровки: ведомость, служебные блоки конвейера, длинный текст.",
);
console.log(`проект: ${project.name} [${project.id}]`);

const buffer = await readFile(path.join(SAMPLES_DIR, "komplekt-demo-ru.pdf"));
const doc = await storage.saveDocument({
  projectId: project.id,
  originalName: "Фикстура UI — ведомость, чертёж, текст.pdf",
  buffer,
});
console.log(`файл: ${doc.pageCount} листов`);

/** Лист 1 — ведомость (kind=table), 2 — чертёж со служебными блоками, дальше текст. */
const PLAN: Array<{ kind: "table" | "drawing" | "text"; body: (page: number) => string }> = [
  { kind: "table", body: () => vedomostMarkdown() },
  { kind: "drawing", body: drawingMarkdown },
  { kind: "text", body: textMarkdown },
  { kind: "table", body: () => vedomostMarkdown() },
  { kind: "drawing", body: drawingMarkdown },
  { kind: "text", body: textMarkdown },
];

const last = Math.min(PLAN.length, doc.pageCount);
for (let page = 1; page <= last; page += 1) {
  const slot = PLAN[page - 1];
  await storage.ingestPage({
    documentId: doc.id,
    pageNumber: page,
    markdown: slot.body(page),
    kind: slot.kind,
    source: "model",
  });
}
await storage.updateDocument(doc.id, {
  status: "done",
  processingStep: "done",
  processingPage: null,
  errorMessage: null,
});
console.log(`расшифровка: ${last}/${doc.pageCount}`);

// ------------------------------------------------------------------ замечания

function loc(
  pageNumber: number,
  quote: string,
  /** Доля от размеров листа: без rect легенда подсветки не появляется. */
  rect?: { x: number; y: number; w: number; h: number },
) {
  return {
    documentId: doc.id,
    documentName: "Фикстура UI — ведомость, чертёж, текст.pdf",
    pageNumber,
    quote,
    ...(rect ? { rect } : {}),
  };
}

