function vedomostMarkdown(): string {
  const head = [
    "| № поз. | Обозначение документа | Наименование и техническая характеристика | Ед. изм. | Кол. | Примечание |",
    "| --- | --- | --- | --- | --- | --- |",
  ];
  const rows = VEDOMOST_ROWS.map((row) => `| ${row.join(" | ")} |`);
  return [
    "## Страница 14",
    "",
    "# Ведомость потребности в материалах",
    "",
    ...head,
    ...rows,
    "",
    "**Цветовая разметка:** позиции 4–6 в оригинале выделены жёлтым — металл под заказ.",
    "",
    "---",
    "",
    "## Штамп",
    "",
    "| Поле | Значение |",
    "| --- | --- |",
    "| Шифр комплекта | 2024-118-АР5 |",
    "| Стадия | П |",
    "| Лист | 14 |",
    "| Листов | 40 |",
    "| ГИП | Темников А. В. |",
    "",
  ].join("\n");
}

